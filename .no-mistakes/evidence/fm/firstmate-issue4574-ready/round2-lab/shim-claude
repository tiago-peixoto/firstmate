#!/bin/bash
# Recorder standing in for the Claude agent process: prints what account the
# launched agent actually received, then stays alive like a running agent.
{
  echo "=== claude agent process started ==="
  echo "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR-<unset>}"
  echo "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY-<unset>}"
  echo "CLAUDE_CODE_USE_BEDROCK=${CLAUDE_CODE_USE_BEDROCK-<unset>}"
  echo "cwd=$PWD"
} | tee "/var/folders/r8/cylyt7xd7t50y9x5wc05my380000gn/T//fm4574-live/rec/claude.$$.log"
exec sleep 86400
