#!/bin/bash
# Real Pi for the non-interactive checks spawn runs; a recorder for the agent launch.
case "${1:-}" in
auth|--list-models|--help|--version) exec /Users/tiago/.nvm/versions/node/v22.23.1/bin/pi "$@" ;;
esac
{
  echo "=== pi agent process started ==="
  echo "PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR-<unset>}"
  echo "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY-<unset>}"
  printf 'argv:'; for a in "$@"; do case "$a" in *$'\n'*) printf " <brief>";; *) printf ' %q' "$a";; esac; done; echo
  echo "cwd=$PWD"
} | tee "/var/folders/r8/cylyt7xd7t50y9x5wc05my380000gn/T//fm4574-live/rec/pi.$$.log"
exec sleep 86400
