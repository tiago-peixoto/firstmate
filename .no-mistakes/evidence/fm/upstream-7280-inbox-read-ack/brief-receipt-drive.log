-rw-rw-r-- 1 firstmate firstmate   0 Oct 24 18:26 001.msg
record still in inbox root: yes
due_action(grace=0) after read: quiet
record_busy after read returns: 0

## worker finishes: runs the brief's handled move verbatim
command: mv '/tmp/fm-brief-drive.XaRnDX/state/ship.inbox'/001.msg '/tmp/fm-brief-drive.XaRnDX/state/ship.inbox'/handled/
exit=0
001.msg
due_action after handled: quiet

## second steer: worker without a shell uses the file-tool fallback path from the brief
